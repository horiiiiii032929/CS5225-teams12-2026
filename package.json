{
  "name": "flatsplit",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@flatsplit/web",
    "dev:api": "turbo run dev --filter=@flatsplit/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write . && uv run ruff format services",
    "format:check": "prettier --check . && uv run ruff format --check services",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "synth": "pnpm --filter @flatsplit/aws synth",
    "setup:python": "uv sync --locked --all-packages --group dev",
    "test": "turbo run test",
    "deploy:aws": "pnpm build && pnpm --filter @flatsplit/aws run deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
